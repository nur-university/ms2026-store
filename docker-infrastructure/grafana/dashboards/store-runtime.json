{
  "uid": "store-runtime",
  "title": "Store · Runtime .NET",
  "description": "CPU, memoria, GC, hilos, conexiones a base de datos y Kestrel por proceso.",
  "tags": [
    "store",
    "runtime"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 2,
        "query": {
          "query": "label_values(process_memory_usage_bytes{service_namespace=\"store\"}, service_name)",
          "refId": "v"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Store dashboards",
      "type": "dashboards",
      "tags": [
        "store"
