          },
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_namespace=\"store\",http_route!=\"/health\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{service_namespace=\"store\",http_route!=\"/health\"}[$__rate_interval]))",
