          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select coalesce(100.0 * (select count(*) from \"order\" where $__timeFilter(\"failedOn\"))\n            / nullif((select count(*) from \"order\" where $__timeFilter(\"startedOn\") and status not in ('Draft','Discarded')), 0), 0)::float as value"
