    {
      "type": "table",
      "title": "Atascadas: sin avanzar más de 5 minutos",
      "description": "Deberían ser pocas: el worker de Orders falla las notas que superan su tiempo máximo.",
      "datasource": {
        "uid": "pg-orders"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-orders"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select \"orderId\" as \"Nota\", status as \"Estado\", \"startedOn\" as \"Inicio\", extract(epoch from now() - \"startedOn\")::int as \"Espera (s)\", \"customerName\" as \"Cliente\"\n       from \"order\" where status in ('Started','Reserved','PaymentInProcess') and \"startedOn\" < now() - interval '5 minutes'\n       order by \"startedOn\" limit 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Espera (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 15,
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Pagadas y sin retirar (más antiguas primero)",
      "description": "Venta cobrada cuyo stock sigue reservado: un supervisor puede anularla (orders.order:override).",
      "datasource": {
        "uid": "pg-orders"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-orders"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select \"invoiceNumber\" as \"Factura\", \"customerName\" as \"Cliente\", \"totalAmount\" as \"Monto\", \"paidOn\" as \"Pagada\",\n            round(extract(epoch from now() - \"paidOn\") / 3600, 1) as \"Horas esperando\"\n       from \"order\" where status = 'Paid' order by \"paidOn\" limit 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
